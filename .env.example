# Токен бота
TELEGRAM_BOT_TOKEN=

# ID чата/группы, куда отправлять опросы (для супергрупп начинается с -100)
TELEGRAM_CHAT_ID=

# (опционально) путь к файлу хранилища закрепов, по умолчанию polls.json
STORE_PATH=polls.json

# (опционально) cron-расписание проверки, по умолчанию "0 20 * * *" (ежедневно в 20:00).
CRON_SCHEDULE=

# (опционально) таймзона, по умолчанию Europe/Moscow.
# В ней работает планировщик и считаются даты, независимо от зоны сервера.
TIMEZONE=

# (опционально) игровые дни через запятую (англ. названия, регистр не важен),
# по умолчанию: Tuesday,Thursday,Friday,Sunday
GAME_DAYS=
